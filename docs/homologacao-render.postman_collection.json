{
  "info": {
    "name": "StartBig · Homologação da licença (Render)",
    "description": "Roteiro de testes da API de homologação (LIC-05, LIC-06, LIC-09). Passo a passo em docs/homologacao-render.md. Preencha as variáveis da coleção antes de rodar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 · Acordar a API",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/licenca/chave-publica",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "licenca",
            "chave-publica"
          ]
        },
        "description": "Rode primeiro. Se demorar, é o serviço gratuito acordando.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// O plano gratuito \"dorme\": esta chamada acorda a API (pode levar ~50 s).",
              "pm.test('API no ar (200)', () => pm.response.to.have.status(200));",
              "pm.test('Devolve a chave pública de TESTE', () => pm.expect(pm.response.json().publicKey).to.include('BEGIN PUBLIC KEY'));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 · Login do admin (painel)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Usa o admin criado pelo seed.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Guarda o token do admin: ele lê o histórico de e-mails (passo 05).",
              "pm.test('Admin entrou (201)', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Cadastro pelo app NOVO → 202",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/erp/auto-cadastro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "erp",
            "auto-cadastro"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"documento\": \"{{cpf}}\",\n  \"nomeOuRazao\": \"Loja de Teste\",\n  \"email\": \"{{clienteEmail}}\",\n  \"senha\": \"{{clienteSenha}}\",\n  \"fluxoConfirmacao\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// LIC-06: o app novo recebe 202, e nenhuma chave volta na resposta.",
              "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
              "pm.test('Sem chave de ativação na resposta', () => pm.expect(pm.response.text()).to.not.include('chaveAtivacao'));"
            ]
          }
        }
      ]
    },
