    {
      "name": "05 · Achar o e-mail de confirmação",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/email/historico?tipo=CONFIRMACAO_CADASTRO",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "email",
            "historico"
          ],
          "query": [
            {
              "key": "tipo",
              "value": "CONFIRMACAO_CADASTRO"
            }
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Com a chave do Resend falsa, o e-mail não sai, mas fica no histórico (status FALHOU).",
              "// Guarda o id do mais recente para o passo 06.",
              "pm.test('Histórico lido (200)', () => pm.response.to.have.status(200));",
              "const itens = pm.response.json().itens;",
              "pm.test('Há e-mail de confirmação', () => pm.expect(itens.length).to.be.above(0));",
              "pm.collectionVariables.set('emailId', itens[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 · Ler o link de confirmação",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/email/historico/{{emailId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "email",
            "historico",
            "{{emailId}}"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Tira o token do link \"confirmar-cadastro?token=...\" que está no HTML do e-mail.",
              "pm.test('E-mail lido (200)', () => pm.response.to.have.status(200));",
              "const achado = /confirmar-cadastro\\?token=([a-f0-9]+)/.exec(pm.response.json().html);",
              "pm.test('O e-mail tem o link', () => pm.expect(achado).to.not.be.null);",
              "pm.test('O e-mail NÃO leva a chave de ativação', () => pm.expect(pm.response.json().html).to.not.include('START-'));",
              "if (achado) pm.collectionVariables.set('confirmToken', achado[1]);"
            ]
          }
        }
      ]
    },
