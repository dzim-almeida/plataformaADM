              "// com a instrução, que elas mostram na tela.",
              "pm.test('409 CONFIRMACAO_NECESSARIA', () => {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().codigo).to.eql('CONFIRMACAO_NECESSARIA');",
              "});"
            ]
          }
        }
      ]
    },
