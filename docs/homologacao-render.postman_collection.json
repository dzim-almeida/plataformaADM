              "pm.test('Login ok (201)', () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.test('Devolve a chave de ativação', () => pm.expect(r.chaveAtivacao).to.be.a('string'));",
              "pm.collectionVariables.set('licencaToken', r.token);",
              "pm.collectionVariables.set('licencaId', r.licencaId);"
            ]
          }
        }
      ]
